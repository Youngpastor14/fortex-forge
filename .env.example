# ─── Fortex Forge — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# .env is already in .gitignore (verified in A02).
# ─────────────────────────────────────────────────────────────────────────────

# ── Contact Form (Formspree) ──────────────────────────────────────────────────
# Required for the Project Diagnostic Form on /contact to deliver enquiries.
#
# Setup:
#   1. Create a free account at https://formspree.io
#   2. Create a new form, set notification email to hello@fortexforge.com
#   3. Copy the endpoint URL shown on the form dashboard
#   4. Paste it below and restart the dev server
#
# Note: The endpoint URL is a form ID (not a private API key). Formspree's
# security model allows it to be public-facing — spam is managed by their
# own filters. See https://formspree.io/security for details.
#
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id-here

# ── Future integrations (add as needed) ──────────────────────────────────────
# VITE_ANALYTICS_ID=
# VITE_LINKEDIN_URL=
# VITE_WHATSAPP_NUMBER=          # Format: 447700000000 (no +, no spaces)
